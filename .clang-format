---
# ZedInfer C++ Code Style
# Based on LLVM style with project-specific overrides.
# Run: find include/ src/ examples/ -name '*.cpp' -o -name '*.hpp' -o -name '*.h' -o -name '*.cu' -o -name '*.cuh' | xargs clang-format -i

BasedOnStyle: LLVM
Standard: c++17

# --- Indentation ---
IndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: true

# --- Line width ---
ColumnLimit: 120

# --- Braces: K&R (opening brace on same line) ---
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterObjCDeclaration: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
InsertBraces: true

# --- Short constructs on single line ---
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: Inline
AllowShortLoopsOnASingleLine: true
AllowShortIfStatementsOnASingleLine: Never

# --- Pointer / Reference ---
PointerAlignment: Left
ReferenceAlignment: Pointer

# --- Binary operators ---
BreakBeforeBinaryOperators: All
AlignOperands: AlignAfterOperator

# --- Constructor initializers ---
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLine

# --- Includes ---
SortIncludes: CaseInsensitive
IncludeBlocks: Preserve

# --- Whitespace ---
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false
SpacesInAngles: Never

# --- Alignment ---
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1
